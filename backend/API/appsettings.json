{
  "ConnectionStrings": {
    "Default": "Data Source=worldhistory.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "ApplyRowLevelSecurity": true
  },
  "Jwt": {
    "Issuer": "WorldHistory.Api",
    "Audience": "WorldHistory.Client",
    "ExpiryMinutes": 30,
    "Key": ""
  },
  "Security": {
    "IpHashKey": "",
    "DataProtectionKeysPath": "keys",
    "SeedAdminUsername": "",
    "SeedAdminPassword": "",
    "AllowedOrigins": [
      "http://localhost:3000"
    ],
    "RequireHttps": true
  },
  "Email": {
    "Enabled": false,
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseStartTls": true,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Sử Ký Toàn Cầu",
    "ReplyToAddress": "",
    "TimeoutSeconds": 10,
    "QueueCapacity": 100
  },
  "ExternalApi": {
    "Enabled": true,
    "BaseUrlTemplate": "https://{0}.wikipedia.org/w/api.php",
    "TimeoutSeconds": 5,
    "CacheMinutes": 360,
    "MaxLength": 900,
    "UserAgent": "WorldHistoryEncyclopedia/1.0 (https://example.com; contact@example.com)"
  },
  "RateLimit": {
    "GlobalPermitLimit": 300,
    "LoginPermitLimit": 5,
    "ContributionPermitLimit": 3,
    "WindowSeconds": 60,
    "ContributionWindowSeconds": 3600
  },
  "Proxy": {
    "TrustForwardedHeaders": false
  },
  "AllowedHosts": "localhost;127.0.0.1;api",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
