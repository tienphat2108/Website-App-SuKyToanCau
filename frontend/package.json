{
  "name": "world-history-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Bách khoa toàn thư lịch sử thế giới, ưu tiên lịch sử Việt Nam",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "geo:build": "node scripts/build-world-basemap.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:secrets": "node scripts/security-audit.mjs",
    "audit:deps": "npm audit --audit-level=high",
    "audit": "npm run audit:secrets && npm run audit:deps"
  },
  "dependencies": {
    "@animate-ui/react": "^2.4.1",
    "leaflet": "1.9.4",
    "motion": "^14.9.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "5.0.8"
  },
  "overrides": {
    "postcss": "8.5.32",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/leaflet": "1.9.20",
    "@types/node": "22.18.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "5.0.2",
    "autoprefixer": "10.4.21",
    "jsdom": "26.1.0",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "vitest": "4.1.12"
  }
}
