# Mẫu biến môi trường cho tệp điều phối.
# Sao chép tệp này thành devops/.env rồi điền giá trị thật.
# Không đưa tệp .env vào kho mã nguồn.

# ---------------------------------------------------------------------------
# Địa chỉ website
# ---------------------------------------------------------------------------
# Địa chỉ công khai, dùng cho siêu dữ liệu, sơ đồ trang và ảnh chia sẻ.
# Chạy thử tại máy: https://localhost
# Triển khai thật: https://lichsu.example.com
SITE_URL=https://localhost

# Địa chỉ máy chủ đảo ngược lắng nghe.
# Chạy thử tại máy: https://localhost
# Triển khai thật: https://lichsu.example.com
SITE_ADDRESS=https://localhost

# Tệp cấu hình máy chủ đảo ngược.
# Chạy thử tại máy giữ nguyên ./Caddyfile.
# Triển khai thật đổi thành ./Caddyfile.production để lấy chứng chỉ tự động.
CADDYFILE=./Caddyfile

# Thư điện tử nhận thông báo chứng chỉ, chỉ dùng khi triển khai thật.
ACME_EMAIL=

# ---------------------------------------------------------------------------
# Cơ sở dữ liệu
# ---------------------------------------------------------------------------
# Không dùng ký tự $ trong mật khẩu vì tệp .env sẽ hiểu nhầm là biến.
POSTGRES_DB=worldhistory
POSTGRES_USER=worldhistory
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Bí mật của máy chủ dữ liệu
# ---------------------------------------------------------------------------
# Khóa ký mã truy cập, tối thiểu 32 byte. Sinh bằng lệnh:
#   openssl rand -base64 48
JWT_KEY=

# Khóa băm địa chỉ mạng, tối thiểu 32 ký tự. Sinh bằng lệnh:
#   openssl rand -base64 48
IP_HASH_KEY=

# Tài khoản quản trị đầu tiên, chỉ tạo khi cơ sở dữ liệu chưa có tài khoản.
# Mật khẩu phải dài tối thiểu 12 ký tự và không dùng lại ở nơi khác.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Tùy chọn khác
# ---------------------------------------------------------------------------
# Mã đo lường, để trống nếu chưa dùng.
GA_ID=

# Tên miền được phép phục vụ, phân tách bằng dấu chấm phẩy.
# Khi triển khai thật thêm tên miền chính và tên miền phụ.
ALLOWED_HOSTS=localhost;127.0.0.1;api

# Bật hoặc tắt việc lấy thêm tóm tắt từ nguồn tham khảo bên ngoài.
EXTERNAL_API_ENABLED=true

# Chuỗi nhận diện khi gọi nguồn bên ngoài. Nên ghi địa chỉ liên hệ thật.
EXTERNAL_API_USER_AGENT=WorldHistoryEncyclopedia/1.0 (+https://localhost)
